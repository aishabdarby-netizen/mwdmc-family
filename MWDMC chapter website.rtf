auth.onAuthStateChanged(async user => \{\
  if (user) \{\
    currentUser = user;\
    await loadChapterMap();\
    currentChapterId = chapterMap[user.email] || null;\
    showLoggedIn();\
  \} else \{\
    currentUser = null;\
    currentChapterId = null;\
    showLoggedOut();\
  \}\
  loadPublicView();\
\});\
\
async function loadChapterMap() \{\
  try \{\
    const snap = await db.collection('config').doc('chapterMap').get();\
    if (snap.exists) \{ chapterMap = \{ ...LOCAL_CHAPTER_MAP, ...snap.data() \}; \}\
  \} catch(e) \{\}\
\}\
\
async function doLogin() \{\
  const email = document.getElementById('login-email').value.trim();\
  const pass  = document.getElementById('login-password').value;\
  if (!email || !pass) \{ showAlert('Please enter your email and password.', 'danger'); return; \}\
  document.getElementById('login-spinner').style.display = 'inline-block';\
  try \{\
    await auth.signInWithEmailAndPassword(email, pass);\
  \} catch(e) \{\
    document.getElementById('login-spinner').style.display = 'none';\
    showAlert('Sign-in failed: ' + friendlyAuthError(e.code), 'danger');\
  \}\
\}\
\
async function doPasswordReset() \{\
  const email = document.getElementById('login-email').value.trim();\
  if (!email) \{ showAlert('Enter your email address above first.', 'danger'); return; \}\
  try \{\
    await auth.sendPasswordResetEmail(email);\
    showAlert('Password reset email sent. Check your inbox.', 'success');\
  \} catch(e) \{\
    showAlert('Could not send reset email: ' + friendlyAuthError(e.code), 'danger');\
  \}\
\}\
\
function logout() \{ auth.signOut(); \}\
