// ---- Admin view ----\
async function loadAdminView() \{\
  // Load all chapter docs\
  try \{\
    const snap = await db.collection('chapters').get();\
    const adminList = document.getElementById('admin-data-list');\
    if (snap.empty) \{\
      adminList.innerHTML = '<p>No chapter data submitted yet.</p>';\
    \} else \{\
      let html = '<table style="width:100%;border-collapse:collapse">';\
      html += '<tr style="background:var(--bg)"><th style="text-align:left;padding:6px 8px;border-bottom:1px solid var(--border)">Chapter ID</th><th style="text-align:left;padding:6px 8px;border-bottom:1px solid var(--border)">Name</th><th style="text-align:left;padding:6px 8px;border-bottom:1px solid var(--border)">Rep</th><th style="text-align:left;padding:6px 8px;border-bottom:1px solid var(--border)">Attendance</th></tr>';\
      snap.forEach(doc => \{\
        const d = doc.data();\
        html += `<tr>\
          <td style="padding:6px 8px;border-bottom:0.5px solid var(--border)">$\{esc(doc.id)\}</td>\
          <td style="padding:6px 8px;border-bottom:0.5px solid var(--border)">$\{esc(d.chapterName||'\'97')\}</td>\
          <td style="padding:6px 8px;border-bottom:0.5px solid var(--border)">$\{esc(d.repName||'\'97')\}</td>\
          <td style="padding:6px 8px;border-bottom:0.5px solid var(--border)">$\{esc(d.adults||'?')\} adults, $\{esc(d.children||'?')\} children</td>\
        </tr>`;\
      \});\
      html += '</table>';\
      adminList.innerHTML = html;\
    \}\
\
    // Show chapter map assignments\
    const userListEl = document.getElementById('admin-user-list');\
    const entries = Object.entries(chapterMap);\
    if (entries.length === 0) \{\
      userListEl.innerHTML = '<div class="user-row">No chapter assignments configured yet. Edit the LOCAL_CHAPTER_MAP in the code.</div>';\
    \} else \{\
      userListEl.innerHTML = entries.map(([email, chap]) =>\
        `<div class="user-row"><span>$\{esc(email)\}</span><span style="color:var(--primary);font-weight:bold">$\{esc(CHAPTER_NAMES[chap]||chap)\}</span></div>`\
      ).join('');\
    \}\
  \} catch(e) \{\
    document.getElementById('admin-data-list').innerHTML = '<p>Error loading admin data: ' + e.message + '</p>';\
