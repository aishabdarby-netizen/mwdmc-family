    showAlert('Your account is not yet assigned to a chapter. Please contact the reunion administrator.', 'danger');\
  \}\
\}\
\
function showLoggedOut() \{\
  document.getElementById('login-panel').style.display      = 'block';\
  document.getElementById('login-header-btn').style.display = 'inline-block';\
  document.getElementById('logout-btn').style.display       = 'none';\
  document.getElementById('user-info').style.display        = 'none';\
  document.getElementById('page-tabs').style.display        = 'none';\
